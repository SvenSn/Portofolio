<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BudgetApp.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:loc="clr-namespace:BudgetApp.App.Localization"
    xmlns:vm="clr-namespace:BudgetApp.App.ViewModels"
    xmlns:controls="clr-namespace:BudgetApp.App.Controls"
    x:DataType="vm:DashboardViewModel"
    Title="{loc:Translate Text027}"
    Shell.NavBarIsVisible="False">
    <ScrollView>
        <Grid Style="{StaticResource ScreenLayoutStyle}">
            <VerticalStackLayout MaximumWidthRequest="760" HorizontalOptions="Fill" Spacing="32">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate Text028}" Style="{StaticResource Headline}" />
                    <Label Text="{loc:Translate Text029}"
                           Style="{StaticResource FormDescriptionStyle}" />
                </VerticalStackLayout>
                <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" />
                <VerticalStackLayout IsVisible="{Binding HasError}" Spacing="12">
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
                    <Button Text="{loc:Translate Text030}" Command="{Binding LoadCommand}" HorizontalOptions="Start" />
                </VerticalStackLayout>
                <VerticalStackLayout IsVisible="{Binding HasData}" Spacing="28">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{loc:Translate DashboardAccountBalance}" Style="{StaticResource FormFieldLabelStyle}" />
                        <Label Text="{Binding AccountBalance, Converter={StaticResource LocalizedValueConverter}, ConverterParameter=Money}"
                               FontSize="40" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                        <Label Text="{loc:Translate DashboardAccountBalanceDescription}" Style="{StaticResource FormDescriptionStyle}" />
                    </VerticalStackLayout>
                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding MonthLabel}" Style="{StaticResource FormDescriptionStyle}" />
                        <Label Text="{loc:Translate Text031}" Style="{StaticResource FormFieldLabelStyle}" />
                        <Label Text="{Binding Remaining, Converter={StaticResource LocalizedValueConverter}, ConverterParameter=Money}"
                               FontSize="40" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                        <Label Text="{loc:Translate Text032}"
                               Style="{StaticResource FormDescriptionStyle}" />
                    </VerticalStackLayout>
                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                    <Label Text="{loc:Translate Text033}" Style="{StaticResource SubHeadline}" />
                    <controls:FinanceChart Income="{Binding Income}" Expenses="{Binding Expenses}" Categories="{Binding ExpenseCategories}"
                                           HeightRequest="240" WidthRequest="240" HorizontalOptions="Center"
                                           SemanticProperties.Description="{loc:Translate CombinedPieDescription}" />
                    <Label Text="{loc:Translate CombinedPieDescription}" Style="{StaticResource FormDescriptionStyle}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ExpenseCategories}" Spacing="16">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExpenseSlice">
                                <Grid ColumnDefinitions="12,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="4">
                                    <BoxView Color="{Binding Color}" WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Category, Converter={StaticResource EnumTextConverter}}"
                                           FontAttributes="Bold" />
                                    <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="16">
                                        <Label Text="{Binding Amount, Converter={StaticResource LocalizedValueConverter}, ConverterParameter=Money}" />
                                        <Label Text="{Binding Share, Converter={StaticResource LocalizedValueConverter}, ConverterParameter=Percent}"
                                               Style="{StaticResource FormDescriptionStyle}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Grid IsVisible="{Binding HasRemaining}" ColumnDefinitions="12,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="4">
                        <BoxView Color="#22C55E" WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{loc:Translate CombinedPieRemaining}" FontAttributes="Bold" />
                        <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="16">
                            <Label Text="{Binding Remaining, Converter={StaticResource LocalizedValueConverter}, ConverterParameter=Money}" />
                            <Label Text="{Binding RemainingShare, Converter={StaticResource LocalizedValueConverter}, ConverterParameter=Percent}" Style="{StaticResource FormDescriptionStyle}" />
                        </HorizontalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{loc:Translate Text037}" Style="{StaticResource FormDescriptionStyle}" />
                            <Label Text="{Binding Income, Converter={StaticResource LocalizedValueConverter}, ConverterParameter=Money}" FontSize="24" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                            <Label Text="{loc:Translate Text038}" Style="{StaticResource FormDescriptionStyle}" />
                            <Label Text="{Binding Expenses, Converter={StaticResource LocalizedValueConverter}, ConverterParameter=Money}" FontSize="24" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Label Text="{Binding Remaining, Converter={StaticResource LocalizedValueConverter}, ConverterParameter=Text042}" FontSize="22" FontAttributes="Bold" />
                    <Label IsVisible="{Binding IsEmpty}"
                           Text="{loc:Translate Text039}"
                           Style="{StaticResource FormDescriptionStyle}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="12">
                    <Button Text="{loc:Translate Text040}" MinimumHeightRequest="50" Command="{Binding OpenAddTransactionCommand}" />
                    <Button Text="{loc:Translate Text010}" Command="{Binding LoadCommand}" Style="{StaticResource SecondaryNavigationButtonStyle}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
