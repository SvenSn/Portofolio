<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BudgetApp.App.Views.IncomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:loc="clr-namespace:BudgetApp.App.Localization"
    xmlns:vm="clr-namespace:BudgetApp.App.ViewModels"
    xmlns:entities="clr-namespace:BudgetApp.Domain.Entities;assembly=BudgetApp.Domain"
    x:DataType="vm:IncomeViewModel"
    Title="{loc:Translate Text046}"
    Shell.NavBarIsVisible="False">
    <ScrollView>
        <Grid Style="{StaticResource ScreenLayoutStyle}">
            <VerticalStackLayout MaximumWidthRequest="640" HorizontalOptions="Fill" Spacing="28">
                <VerticalStackLayout IsVisible="{Binding HasUnassigned}" Spacing="8">
                    <Label Text="{loc:Translate LegacyIncomeTitle}" Style="{StaticResource SubHeadline}" />
                    <Label Text="{loc:Translate LegacyDescription}" Style="{StaticResource FormDescriptionStyle}" />
                    <Picker ItemsSource="{Binding Unassigned}" SelectedItem="{Binding SelectedUnassigned}"
                            ItemDisplayBinding="{Binding Label}" MinimumHeightRequest="48" />
                    <Button Text="{loc:Translate LinkActiveAccount}" Command="{Binding AssignCommand}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate Text047}" Style="{StaticResource Headline}" />
                    <Label Text="{loc:Translate Text048}"
                           Style="{StaticResource FormDescriptionStyle}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate Text049}" Style="{StaticResource FormFieldLabelStyle}" />
                    <Label Text="{Binding CurrentIncome}" FontSize="30" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                </VerticalStackLayout>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                <VerticalStackLayout Spacing="20">
                    <Label Text="{loc:Translate Text050}" Style="{StaticResource SubHeadline}" />
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{loc:Translate Text005}" Style="{StaticResource FormFieldLabelStyle}" />
                        <Entry Text="{Binding Amount}" Keyboard="Numeric" Placeholder="{loc:NumberExample Value=2500, Example=True}" MinimumHeightRequest="48" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{loc:Translate Text051}" Style="{StaticResource FormFieldLabelStyle}" />
                        <DatePicker Date="{Binding EffectiveFrom}" Format="d" MinimumHeightRequest="48" />
                    </VerticalStackLayout>
                    <Label Text="{loc:Translate Text052}"
                           Style="{StaticResource FormDescriptionStyle}" />
                    <Button Text="{loc:Translate Text053}" Command="{Binding SaveCommand}" MinimumHeightRequest="50" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                    <Label Text="{Binding Message}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="16">
                    <Label Text="{loc:Translate Text054}" Style="{StaticResource SubHeadline}" />
                    <Label Text="{loc:Translate Text055}" IsVisible="{Binding IsEmpty}"
                           Style="{StaticResource FormDescriptionStyle}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Incomes}" Spacing="16">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="entities:Income">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,8">
                                    <Label Text="{Binding EffectiveFrom, Converter={StaticResource LocalizedValueConverter}, ConverterParameter=Text056}"
                                           Style="{StaticResource FormDescriptionStyle}" />
                                    <Label Grid.Column="1" Text="{Binding Amount, Converter={StaticResource LocalizedValueConverter}, ConverterParameter=Money}" FontAttributes="Bold" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="{loc:Translate Text010}" Command="{Binding LoadCommand}" Style="{StaticResource SecondaryNavigationButtonStyle}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
