<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:loc="clr-namespace:BudgetApp.App.Localization"
 xmlns:vm="clr-namespace:BudgetApp.App.ViewModels"
 xmlns:entities="clr-namespace:BudgetApp.Domain.Entities;assembly=BudgetApp.Domain"
 x:Class="BudgetApp.App.Views.SavingsPage" x:DataType="vm:SavingsViewModel" Title="{loc:Translate Text078}">
 <ScrollView>
<Grid Style="{StaticResource ScreenLayoutStyle}">
<VerticalStackLayout MaximumWidthRequest="760" HorizontalOptions="Fill" Spacing="20">
 <Label Text="{loc:Translate Text078}" Style="{StaticResource Headline}" />
 <Label Text="{loc:Translate ActiveSavingsDescription}" Style="{StaticResource FormDescriptionStyle}" />
 <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
 <Label Text="{Binding Message}" />
 <VerticalStackLayout Spacing="16" IsEnabled="{Binding IsReady}">
<Label Text="{Binding Total, Converter={StaticResource LocalizedValueConverter}, ConverterParameter=Money}" FontSize="36" FontAttributes="Bold" />
<Label Text="{Binding GoalSummary}" />
<Button Text="{loc:Translate Text080}" Command="{Binding GoalsCommand}" MinimumHeightRequest="48" />
<Button Text="{loc:Translate Text019}" Command="{Binding AddAccountCommand}" MinimumHeightRequest="48" />
<CollectionView ItemsSource="{Binding Items}" SelectionMode="None" HeightRequest="320">
<CollectionView.EmptyView>
<Label Text="{loc:Translate Text016}" />
</CollectionView.EmptyView>
<CollectionView.ItemTemplate>
<DataTemplate x:DataType="entities:Account">
<VerticalStackLayout Padding="12,16" Spacing="8">
<Label Text="{Binding Name}" />
<Label Text="{Binding Balance, Converter={StaticResource LocalizedValueConverter}, ConverterParameter=Money}" />
</VerticalStackLayout>
</DataTemplate>
</CollectionView.ItemTemplate>
</CollectionView>
</VerticalStackLayout>
 <Button Text="{loc:Translate Text010}" Command="{Binding LoadCommand}" Style="{StaticResource QuietActionStyle}" />
 </VerticalStackLayout>
</Grid>
</ScrollView>
</ContentPage>
