<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:loc="clr-namespace:BudgetApp.App.Localization"
 xmlns:vm="clr-namespace:BudgetApp.App.ViewModels"
 xmlns:entities="clr-namespace:BudgetApp.Domain.Entities;assembly=BudgetApp.Domain"
 x:Class="BudgetApp.App.Views.MonthlyDetailsPage" x:DataType="vm:MonthlyDetailsViewModel" Title="{loc:Translate Text057}">
 <ScrollView>
<Grid Style="{StaticResource ScreenLayoutStyle}">
<VerticalStackLayout MaximumWidthRequest="760" HorizontalOptions="Fill" Spacing="20">
 <Label Text="{loc:Translate Text057}" Style="{StaticResource Headline}" />
 <Label Text="{loc:Translate Text058}" Style="{StaticResource FormDescriptionStyle}" />
 <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
 <Label Text="{Binding Message}" />
 <VerticalStackLayout Spacing="16" IsEnabled="{Binding IsReady}">
<Label Text="{Binding Heading}" FontSize="24" FontAttributes="Bold" />
<Label Text="{Binding Income, Converter={StaticResource LocalizedValueConverter}, ConverterParameter=Text059}" />
<Label Text="{Binding Expenses, Converter={StaticResource LocalizedValueConverter}, ConverterParameter=Text060}" />
<Label Text="{Binding Remaining, Converter={StaticResource LocalizedValueConverter}, ConverterParameter=Text061}" FontSize="28" />
<CollectionView ItemsSource="{Binding Items}" SelectionMode="None" HeightRequest="320">
<CollectionView.EmptyView>
<Label Text="{loc:Translate Text016}" />
</CollectionView.EmptyView>
<CollectionView.ItemTemplate>
<DataTemplate x:DataType="entities:Transaction">
<VerticalStackLayout Padding="12,16" Spacing="8">
<Label Text="{Binding Description}" />
<Label Text="{Binding Amount, Converter={StaticResource LocalizedValueConverter}, ConverterParameter=Money}" />
<Label Text="{Binding Type, Converter={StaticResource EnumTextConverter}}" />
<Label Text="{Binding Date, Converter={StaticResource LocalizedValueConverter}, ConverterParameter=Date}" />
</VerticalStackLayout>
</DataTemplate>
</CollectionView.ItemTemplate>
</CollectionView>
</VerticalStackLayout>
 <Button Text="{loc:Translate Text010}" Command="{Binding LoadCommand}" Style="{StaticResource QuietActionStyle}" />
 </VerticalStackLayout>
</Grid>
</ScrollView>
</ContentPage>
