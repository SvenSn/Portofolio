<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="BudgetApp.App.Views.CreateNewAccountPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:loc="clr-namespace:BudgetApp.App.Localization"
    xmlns:vm="clr-namespace:BudgetApp.App.ViewModels"
    x:DataType="vm:CreateNewAccountViewModel"
    Title="{loc:Translate Text019}">

    <ScrollView>
        <Grid Style="{StaticResource ScreenLayoutStyle}">

            <VerticalStackLayout
                MaximumWidthRequest="480"
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                Spacing="32">

                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="{loc:Translate Text020}"
                        Style="{StaticResource Headline}" />

                    <Label
                        Text="{loc:Translate Text021}"
                        Style="{StaticResource FormDescriptionStyle}" />
                </VerticalStackLayout>

                    <VerticalStackLayout Spacing="24">

                        <VerticalStackLayout Spacing="8">
                            <Label
                                Text="{loc:Translate Text022}"
                                Style="{StaticResource FormFieldLabelStyle}" />

                                <Entry
                                    Text="{Binding Name}"
                                    Placeholder="{loc:Translate Text023}"
                                    MinimumHeightRequest="48"
                                    MaxLength="100" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label
                                Text="{loc:Translate Text024}"
                                Style="{StaticResource FormFieldLabelStyle}" />

                                <Picker
                                    MinimumHeightRequest="48"
                                    ItemsSource="{Binding AccountTypes}"
                                    ItemDisplayBinding="{Binding ., Converter={StaticResource EnumTextConverter}}"
                                    SelectedItem="{Binding SelectedAccountType}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label
                                Text="{loc:Translate Text025}"
                                Style="{StaticResource FormFieldLabelStyle}" />

                                <Entry
                                    Text="{Binding OpeningBalance}"
                                    MinimumHeightRequest="48"
                                    Keyboard="Numeric"
                                    Placeholder="{loc:NumberExample Value=0}" />

                            <Label
                                Text="{loc:Translate Text026}"
                                Style="{StaticResource FormDescriptionStyle}" />
                        </VerticalStackLayout>

                        <Label
                            Text="{Binding ErrorMessage}"
                            IsVisible="{Binding HasError}"
                            TextColor="{AppThemeBinding
                                Light={StaticResource DangerLight},
                                Dark={StaticResource DangerDark}}" />

                        <Button
                            Text="{loc:Translate Text019}"
                            MinimumHeightRequest="50"
                            Margin="0,8,0,0"
                            Command="{Binding CreateAccountCommand}" />

                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            HorizontalOptions="Center" />

                    </VerticalStackLayout>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
