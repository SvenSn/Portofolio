<?xml version="1.0" encoding="UTF-8" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Base colors -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

    <!-- Brand -->
    <Color x:Key="Primary">#4F46E5</Color>
    <Color x:Key="PrimaryLight">#4F46E5</Color>
    <Color x:Key="PrimaryDark">#818CF8</Color>

    <!-- Light theme -->
    <Color x:Key="PageBackgroundLight">#F7F8FC</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>

    <Color x:Key="PrimaryTextLight">#111827</Color>
    <Color x:Key="SecondaryTextLight">#6B7280</Color>

    <Color x:Key="BorderLight">#E5E7EB</Color>

    <Color x:Key="SuccessLight">#16A34A</Color>
    <Color x:Key="WarningLight">#D97706</Color>
    <Color x:Key="DangerLight">#DC2626</Color>

    <!-- Dark theme -->
    <Color x:Key="PageBackgroundDark">#0F172A</Color>
    <Color x:Key="SurfaceDark">#1E293B</Color>

    <Color x:Key="PrimaryTextDark">#F8FAFC</Color>
    <Color x:Key="SecondaryTextDark">#94A3B8</Color>

    <Color x:Key="BorderDark">#334155</Color>

    <Color x:Key="SuccessDark">#4ADE80</Color>
    <Color x:Key="WarningDark">#FBBF24</Color>
    <Color x:Key="DangerDark">#F87171</Color>

</ResourceDictionary>