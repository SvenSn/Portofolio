<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:loc="clr-namespace:BudgetApp.App.Localization"
 xmlns:vm="clr-namespace:BudgetApp.App.ViewModels"
 xmlns:entities="clr-namespace:BudgetApp.Domain.Entities;assembly=BudgetApp.Domain"
 x:Class="BudgetApp.App.Views.BudgetsPage" x:DataType="vm:BudgetsViewModel" Title="{loc:Translate Text011}">
 <ScrollView>
<Grid Style="{StaticResource ScreenLayoutStyle}">
<VerticalStackLayout MaximumWidthRequest="760" HorizontalOptions="Fill" Spacing="20">
 <Label Text="{loc:Translate Text011}" Style="{StaticResource Headline}" />
 <Label Text="{loc:Translate Text012}" Style="{StaticResource FormDescriptionStyle}" />
 <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
 <Label Text="{Binding Message}" />
 <VerticalStackLayout Spacing="16" IsEnabled="{Binding IsReady}">
<VerticalStackLayout IsVisible="{Binding HasUnassigned}" Spacing="8">
    <Label Text="{loc:Translate LegacyBudgetTitle}" Style="{StaticResource SubHeadline}" />
    <Label Text="{loc:Translate LegacyDescription}" Style="{StaticResource FormDescriptionStyle}" />
    <Picker ItemsSource="{Binding Unassigned}" SelectedItem="{Binding SelectedUnassigned}"
            ItemDisplayBinding="{Binding Label}" MinimumHeightRequest="48" />
    <Button Text="{loc:Translate LinkActiveAccount}" Command="{Binding AssignCommand}" />
</VerticalStackLayout>
<Label Text="{loc:Translate Text007}" Style="{StaticResource FormFieldLabelStyle}" />
<Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"
        ItemDisplayBinding="{Binding ., Converter={StaticResource EnumTextConverter}}" MinimumHeightRequest="48" />
<Label Text="{loc:Translate Text013}" Style="{StaticResource FormFieldLabelStyle}" />
<DatePicker Date="{Binding Month}" Format="Y" />
<Label Text="{loc:Translate Text014}" Style="{StaticResource FormFieldLabelStyle}" />
<Entry Text="{Binding Amount}" Keyboard="Numeric" MinimumHeightRequest="48" />
<Button Text="{loc:Translate Text015}" Command="{Binding SaveCommand}" MinimumHeightRequest="48" />
<CollectionView ItemsSource="{Binding Items}" SelectionMode="Single" SelectedItem="{Binding Selected}" HeightRequest="320">
<CollectionView.EmptyView>
<Label Text="{loc:Translate Text016}" />
</CollectionView.EmptyView>
<CollectionView.ItemTemplate>
<DataTemplate x:DataType="entities:Budget">
<VerticalStackLayout Padding="12,16" Spacing="8">
<Label Text="{Binding Category, Converter={StaticResource EnumTextConverter}}" />
<Label Text="{Binding Amount, Converter={StaticResource LocalizedValueConverter}, ConverterParameter=Money}" />
<Label Text="{Binding Month, Converter={StaticResource LocalizedValueConverter}, ConverterParameter=Text018}" />
<Label Text="{Binding Year}" />
</VerticalStackLayout>
</DataTemplate>
</CollectionView.ItemTemplate>
</CollectionView>
<Button Text="{loc:Translate Text017}" Command="{Binding DeleteCommand}" Style="{StaticResource DeleteActionStyle}" />
</VerticalStackLayout>
 <Button Text="{loc:Translate Text010}" Command="{Binding LoadCommand}" Style="{StaticResource QuietActionStyle}" />
 </VerticalStackLayout>
</Grid>
</ScrollView>
</ContentPage>
