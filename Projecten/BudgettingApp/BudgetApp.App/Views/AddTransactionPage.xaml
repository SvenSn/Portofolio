<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:loc="clr-namespace:BudgetApp.App.Localization"
 xmlns:vm="clr-namespace:BudgetApp.App.ViewModels"
 xmlns:entities="clr-namespace:BudgetApp.Domain.Entities;assembly=BudgetApp.Domain"
 x:Class="BudgetApp.App.Views.AddTransactionPage" x:DataType="vm:AddTransactionViewModel" Title="{loc:Translate Text001}">
 <ScrollView>
<Grid Style="{StaticResource ScreenLayoutStyle}">
<VerticalStackLayout MaximumWidthRequest="760" HorizontalOptions="Fill" Spacing="20">
 <Label Text="{loc:Translate Text001}" Style="{StaticResource Headline}" />
 <Label Text="{loc:Translate Text002}" Style="{StaticResource FormDescriptionStyle}" />
 <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
 <Label Text="{Binding Message}" />
 <VerticalStackLayout Spacing="16" IsEnabled="{Binding IsReady}">
<Label Text="{loc:Translate Text004}" Style="{StaticResource FormFieldLabelStyle}" />
<Entry Text="{Binding Description}" Keyboard="Default" MinimumHeightRequest="48" />
<Label Text="{loc:Translate Text005}" Style="{StaticResource FormFieldLabelStyle}" />
<Entry Text="{Binding Amount}" Keyboard="Numeric" MinimumHeightRequest="48" />
<Label Text="{loc:Translate Text006}" Style="{StaticResource FormFieldLabelStyle}" />
<Picker ItemsSource="{Binding Types}" SelectedItem="{Binding Type}"
        ItemDisplayBinding="{Binding ., Converter={StaticResource EnumTextConverter}}" MinimumHeightRequest="48" />
<Label Text="{loc:Translate Text007}" Style="{StaticResource FormFieldLabelStyle}" />
<Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"
        ItemDisplayBinding="{Binding ., Converter={StaticResource EnumTextConverter}}" MinimumHeightRequest="48" />
<Label Text="{loc:Translate Text008}" Style="{StaticResource FormFieldLabelStyle}" />
<DatePicker Date="{Binding Date}"  Format="d" />
<Button Text="{loc:Translate Text009}" Command="{Binding SaveCommand}" MinimumHeightRequest="48" />
</VerticalStackLayout>
 <Button Text="{loc:Translate Text010}" Command="{Binding LoadCommand}" Style="{StaticResource QuietActionStyle}" />
 </VerticalStackLayout>
</Grid>
</ScrollView>
</ContentPage>
