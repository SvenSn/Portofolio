<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:loc="clr-namespace:BudgetApp.App.Localization"
 xmlns:vm="clr-namespace:BudgetApp.App.ViewModels"
 xmlns:entities="clr-namespace:BudgetApp.Domain.Entities;assembly=BudgetApp.Domain"
 x:Class="BudgetApp.App.Views.HistoryPage" x:DataType="vm:HistoryViewModel" Title="{loc:Translate Text043}">
 <ScrollView>
<Grid Style="{StaticResource ScreenLayoutStyle}">
<VerticalStackLayout MaximumWidthRequest="760" HorizontalOptions="Fill" Spacing="20">
 <Label Text="{loc:Translate Text043}" Style="{StaticResource Headline}" />
 <Label Text="{loc:Translate Text044}" Style="{StaticResource FormDescriptionStyle}" />
 <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
 <Label Text="{Binding Message}" />
 <VerticalStackLayout Spacing="16" IsEnabled="{Binding IsReady}">
<CollectionView ItemsSource="{Binding Items}" SelectionMode="Single" SelectedItem="{Binding Selected}" HeightRequest="320">
<CollectionView.EmptyView>
<Label Text="{loc:Translate Text016}" />
</CollectionView.EmptyView>
<CollectionView.ItemTemplate>
<DataTemplate x:DataType="vm:HistoryRow">
<VerticalStackLayout Padding="12,16" Spacing="8">
<Label Text="{Binding Label}" />
</VerticalStackLayout>
</DataTemplate>
</CollectionView.ItemTemplate>
</CollectionView>
<Button Text="{loc:Translate Text045}" Command="{Binding OpenCommand}" MinimumHeightRequest="48" />
</VerticalStackLayout>
 <Button Text="{loc:Translate Text010}" Command="{Binding LoadCommand}" Style="{StaticResource QuietActionStyle}" />
 </VerticalStackLayout>
</Grid>
</ScrollView>
</ContentPage>
